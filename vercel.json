{
  "version": 2,
  "name": "dietk-meta",
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/required.html"
    },
    {
      "src": "/careers",
      "dest": "/careers.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}